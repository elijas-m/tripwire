# /etc/tripwire/secrets.env — owner tripwire:tripwire, mode 0600.
# Never commit real values.

# Telegram bot (long polling; no inbound ports).
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
TELEGRAM_CHAT_ID=-1001234567890

# Forum topic thread_ids (integer message_thread_id of each topic).
TG_THREAD_CRITICAL=1
TG_THREAD_WARNING=2
TG_THREAD_NATURE=3
TG_THREAD_HEALTH=4
TG_THREAD_DIGEST=5
TG_THREAD_TEST=6

# Comma-separated Telegram user_ids allowed to run /ack /mute /reload etc.
TRIPWIRE_ADMINS=111111111

# ntfy fallback (used after 3 consecutive Telegram failures).
NTFY_TOPIC=tripwire-REPLACE_WITH_RANDOM

# Optional sources.
FAA_NOTAM_API_KEY=
AUTOROUTER_TOKEN=
